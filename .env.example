# PostgreSQL
POSTGRES_USER=bear
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=bear

# Redis
REDIS_PASSWORD=replace_with_redis_password

# Application database connections
DATABASE_URL=postgresql://bear:replace_with_local_password@127.0.0.1:5432/bear
REDIS_URL=redis://:replace_with_redis_password@127.0.0.1:6379